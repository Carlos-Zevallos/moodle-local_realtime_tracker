{{!
    @template local_realtime_tracker/student_detail

    Student activity detail report.

    Example context (json):
    {
        "studentname": "Student Name",
        "studentemail": "student@example.com",
        "pdfurl": "#",
        "activities": [{"name": "Forum", "type": "forum", "entries": 3, "time": "1h 0m", "status": "Completed"}]
    }
}}
<div class="mauri-student-detail p-4 bg-white shadow-sm border rounded">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h3 class="text-primary">{{#str}} studentreport, local_realtime_tracker {{/str}}</h3>
        <div class="dropdown">
            <button class="btn btn-danger dropdown-toggle" type="button" id="exportDropdown" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fa fa-download"></i> {{#str}} export, local_realtime_tracker {{/str}}
            </button>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="exportDropdown">
                <a class="dropdown-item" href="{{pdfurl}}"><i class="fa fa-file-pdf-o text-danger"></i> {{#str}} exportpdf, local_realtime_tracker {{/str}}</a>
                <a class="dropdown-item" href="{{docurl}}"><i class="fa fa-file-word-o text-primary"></i> {{#str}} exportdoc, local_realtime_tracker {{/str}}</a>
                <a class="dropdown-item" href="{{xmlurl}}"><i class="fa fa-file-code-o text-warning"></i> {{#str}} exportxml, local_realtime_tracker {{/str}}</a>
            </div>
        </div>
    </div>

    <div class="alert alert-info d-flex align-items-center">
        <div class="mr-3 me-3" style="font-size: 2rem;"><i class="fa fa-user-circle"></i></div>
        <div>
            <strong>{{#str}} student, local_realtime_tracker {{/str}}:</strong> {{studentname}}<br>
            <small>{{studentemail}}</small>
        </div>
    </div>

    <div class="row mb-4 text-center">
        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6 class="text-muted">{{#str}} firstaccess, local_realtime_tracker {{/str}}</h6>
                    <strong>{{firstaccess}}</strong>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6 class="text-muted">{{#str}} lastaccess, local_realtime_tracker {{/str}}</h6>
                    <strong>{{lastaccess}}</strong>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">{{#str}} activitytracking, local_realtime_tracker {{/str}}</h4>
    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <thead style="background-color: #0d6efd !important;">
                <tr>
                    <th style="color: #ffffff !important;">{{#str}} activity, local_realtime_tracker {{/str}}</th>
                    <th style="color: #ffffff !important;">{{#str}} type, local_realtime_tracker {{/str}}</th>
                    <th style="color: #ffffff !important;">{{#str}} entries, local_realtime_tracker {{/str}}</th>
                    <th style="color: #ffffff !important;">{{#str}} time, local_realtime_tracker {{/str}}</th>
                    <th style="color: #ffffff !important;">{{#str}} status, local_realtime_tracker {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#activities}}
                <tr>
                    <td>{{name}}</td>
                    <td>{{type}}</td>
                    <td>{{entries}}</td>
                    <td><strong>{{time}}</strong></td>
                    <td class="text-success">{{status}}</td>
                </tr>
                {{/activities}}
                {{^activities}}
                <tr><td colspan="5" class="text-center">{{#str}} noactivityrecords, local_realtime_tracker {{/str}}</td></tr>
                {{/activities}}
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 text-center text-muted">
    <small>{{#str}} footercredit, local_realtime_tracker {{/str}}</small>
</div>
