<div class="mauri-student-detail p-4 bg-white shadow-sm border rounded">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h3 class="text-primary">{{#str}} studentreport, local_realtime_tracker {{/str}}</h3>
        <div class="dropdown">
            <button class="btn btn-danger dropdown-toggle" type="button" id="exportDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <i class="fa fa-download"></i> Exportar
            </button>
            <div class="dropdown-menu dropdown-menu-right" aria-labelledby="exportDropdown">
                <a class="dropdown-item" href="export.php?courseid={{courseid}}&userid={{userid}}&format=pdf"><i class="fa fa-file-pdf-o text-danger"></i> Exportar PDF</a>
                <a class="dropdown-item" href="export.php?courseid={{courseid}}&userid={{userid}}&format=doc"><i class="fa fa-file-word-o text-primary"></i> Exportar DOC</a>
                <a class="dropdown-item" href="export.php?courseid={{courseid}}&userid={{userid}}&format=xml"><i class="fa fa-file-code-o text-warning"></i> Exportar XML</a>
            </div>
        </div>
    </div>

    <div class="alert alert-info d-flex align-items-center">
        <div class="mr-3 me-3" style="font-size: 2rem;"><i class="fa fa-user-circle"></i></div>
        <div>
            <strong>{{#str}} student, local_realtime_tracker {{/str}}:</strong> {{studentname}}<br>
            <small>{{studentemail}}</small>
        </div>
    </div>

    <div class="row mb-4 text-center">
        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6 class="text-muted">{{#str}} firstaccess, local_realtime_tracker {{/str}}</h6>
                    <strong>{{firstaccess}}</strong>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6 class="text-muted">{{#str}} lastaccess, local_realtime_tracker {{/str}}</h6>
                    <strong>{{lastaccess}}</strong>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Seguimiento Total por Actividad</h4>
    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <thead class="bg-primary text-white">
                <tr>
                    <th>{{#str}} activity, local_realtime_tracker {{/str}}</th>
                    <th>{{#str}} type, local_realtime_tracker {{/str}}</th>
                    <th>{{#str}} entries, local_realtime_tracker {{/str}}</th>
                    <th>{{#str}} time, local_realtime_tracker {{/str}}</th>
                    <th>{{#str}} status, local_realtime_tracker {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#activities}}
                <tr>
                    <td>{{name}}</td>
                    <td>{{type}}</td>
                    <td>{{entries}}</td>
                    <td><strong>{{time}}</strong></td>
                    <td class="text-success">{{status}}</td>
                </tr>
                {{/activities}}
                {{^activities}}
                <tr><td colspan="5" class="text-center">No hay registros de actividades.</td></tr>
                {{/activities}}
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 text-center text-muted">
    <small>desarrollado por Ing. Carlos Zevallos | PLUGIN MAURI|</small>
</div>

