{{!
    @template local_realtime_tracker/dashboard

    Course tracking dashboard.

    Example context (json):
    {
        "courseid": 2,
        "coursename": "Course name",
        "centername": "Training centre",
        "cif": "12345678Z",
        "modalidad": "Distance learning",
        "isstudent": true,
        "studenturl": "/local/realtime_tracker/reports.php",
        "users": [{"fullname": "Student", "email": "a@example.com", "detailurl": "#"}]
    }
}}
<div class="mauri-dashboard-container p-4 bg-white shadow-sm border rounded">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h3 class="text-primary">{{#str}} generalreport, local_realtime_tracker {{/str}}</h3>
    </div>

    <div class="row mb-4 text-muted small">
        <div class="col-md-4">
            <strong>{{#str}} trainingcentre, local_realtime_tracker {{/str}}:</strong> {{centername}}<br>
            <strong>{{#str}} actionname, local_realtime_tracker {{/str}}:</strong> {{coursename}}
        </div>
        <div class="col-md-4">
            <strong>{{#str}} cifnumber, local_realtime_tracker {{/str}}:</strong> {{cif}}<br>
            <strong>{{#str}} accesslabel, local_realtime_tracker {{/str}}:</strong> {{#str}} companygroup, local_realtime_tracker {{/str}}<br>
            <strong>{{#str}} modality, local_realtime_tracker {{/str}}:</strong> {{modalidad}}
        </div>
    </div>

    <div class="mb-4">
        <ul class="nav nav-pills">
            <li class="nav-item">
                <a class="nav-link {{#isstudent}}active{{/isstudent}}" href="{{studenturl}}">{{#str}} students, local_realtime_tracker {{/str}}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{#isteacher}}active{{/isteacher}}" href="{{teacherurl}}">{{#str}} teachers, local_realtime_tracker {{/str}}</a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{#isall}}active{{/isall}}" href="{{allurl}}">{{#str}} allusers, local_realtime_tracker {{/str}}</a>
            </li>
        </ul>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>{{#str}} student, local_realtime_tracker {{/str}}</th>
                    <th>{{#str}} firstaccess, local_realtime_tracker {{/str}}</th>
                    <th>{{#str}} lastaccess, local_realtime_tracker {{/str}}</th>
                    <th>{{#str}} totalaccesses, local_realtime_tracker {{/str}}</th>
                    <th>{{#str}} activetime, local_realtime_tracker {{/str}}</th>
                    <th>{{#str}} action, local_realtime_tracker {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#users}}
                <tr>
                    <td>
                        <strong>{{fullname}}</strong><br>
                        <small class="text-muted">{{email}}</small>
                    </td>
                    <td>{{firstaccess}}</td>
                    <td>{{lastaccess}}</td>
                    <td>{{accesses}}</td>
                    <td><span class="badge badge-primary bg-primary">{{activetime}}</span></td>
                    <td>
                        <a href="{{detailurl}}" class="btn btn-sm btn-info text-white">{{#str}} viewdetail, local_realtime_tracker {{/str}}</a>
                    </td>
                </tr>
                {{/users}}
                {{^users}}
                <tr><td colspan="6" class="text-center">{{#str}} norecords, local_realtime_tracker {{/str}}</td></tr>
                {{/users}}
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 text-center text-muted">
    <small>{{#str}} footercredit, local_realtime_tracker {{/str}}</small>
</div>
