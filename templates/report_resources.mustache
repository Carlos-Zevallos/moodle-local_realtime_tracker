{{!
    @template local_realtime_tracker/report_resources

    Institutional resources report.

    Example context (json):
    {
        "categoryid": 0,
        "year": "2026",
        "results": [{"categoryname": "School", "coursename": "Course", "teachername": "Teacher"}]
    }
}}
<div class="mauri-dashboard">
    <div class="row mb-4">
        <div class="col-12">
            <form class="form-inline" method="get" action="{{currenturl}}">
                <div class="form-group mr-3">
                    <label for="categoryid" class="mr-2">{{#str}} category, local_realtime_tracker {{/str}}</label>
                    <select id="categoryid" name="categoryid" class="custom-select">
                        <option value="0">{{#str}} all, local_realtime_tracker {{/str}}</option>
                        {{#topcategories}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/topcategories}}
                    </select>
                </div>

                <div class="form-group mr-3">
                    <label for="subcategoryid" class="mr-2">{{#str}} subcategory, local_realtime_tracker {{/str}}</label>
                    <select id="subcategoryid" name="subcategoryid" class="custom-select">
                        <option value="0">{{#str}} all, local_realtime_tracker {{/str}}</option>
                    </select>
                </div>

                <div class="form-group mr-3">
                    <label for="year" class="mr-2">{{#str}} year, local_realtime_tracker {{/str}}</label>
                    <input type="number" id="year" name="year" class="form-control" value="{{year}}" placeholder="{{#str}} yearplaceholder, local_realtime_tracker {{/str}}">
                </div>

                <div class="form-group mr-3">
                    <label for="semester" class="mr-2">{{#str}} semester, local_realtime_tracker {{/str}}</label>
                    <select id="semester" name="semester" class="custom-select">
                        <option value="">{{#str}} allsemesters, local_realtime_tracker {{/str}}</option>
                        <option value="01" {{#sem01}}selected{{/sem01}}>{{#str}} firstsemester, local_realtime_tracker {{/str}}</option>
                        <option value="02" {{#sem02}}selected{{/sem02}}>{{#str}} secondsemester, local_realtime_tracker {{/str}}</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">{{#str}} filter, local_realtime_tracker {{/str}}</button>
            </form>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-10 offset-md-1">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0">{{#str}} resourcedistribution, local_realtime_tracker {{/str}}</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 mb-4">
                            {{{chart1}}}
                        </div>
                        <div class="col-md-8 offset-md-2">
                            <table class="table table-bordered table-sm">
                                <thead class="thead-light">
                                    <tr>
                                        <th>{{#str}} resource, local_realtime_tracker {{/str}}</th>
                                        <th class="text-center">{{#str}} total, local_realtime_tracker {{/str}}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#chart_data}}
                                    <tr>
                                        <td>{{label}}</td>
                                        <td class="text-center"><strong>{{value}}</strong></td>
                                    </tr>
                                    {{/chart_data}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">{{#str}} results, local_realtime_tracker {{/str}}</h5>
            <div class="d-flex align-items-center">
                <button type="button" class="btn btn-info mr-2" data-action="email-report">
                    <i class="fa fa-envelope"></i> {{#str}} sendtoteachers, local_realtime_tracker {{/str}}
                </button>
                <div class="dropdown d-inline-block">
                    <button class="btn btn-danger dropdown-toggle" type="button" id="exportResourcesDropdown" data-toggle="dropdown" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-download"></i> {{#str}} export, local_realtime_tracker {{/str}}
                    </button>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="exportResourcesDropdown">
                        <a class="dropdown-item" href="#" data-action="export-report" data-format="pdf"><i class="fa fa-file-pdf-o text-danger"></i> {{#str}} exportpdf, local_realtime_tracker {{/str}}</a>
                        <a class="dropdown-item" href="#" data-action="export-report" data-format="doc"><i class="fa fa-file-word-o text-primary"></i> {{#str}} exportdoc, local_realtime_tracker {{/str}}</a>
                        <a class="dropdown-item" href="#" data-action="export-report" data-format="xlsx"><i class="fa fa-file-excel-o text-success"></i> {{#str}} exportexcel, local_realtime_tracker {{/str}}</a>
                        <a class="dropdown-item" href="#" data-action="export-report" data-format="xml"><i class="fa fa-file-code-o text-warning"></i> {{#str}} exportxml, local_realtime_tracker {{/str}}</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="thead-light">
                    <tr>
                        <th>{{#str}} school, local_realtime_tracker {{/str}}</th>
                        <th>{{#str}} courses, local_realtime_tracker {{/str}}</th>
                        <th>{{#str}} teacher, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} url, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} label, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} assignment, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} forums, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} files, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} teams, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} folder, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} sharedresources, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} students, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} connectiontime, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} creationtime, local_realtime_tracker {{/str}}</th>
                        <th class="text-center">{{#str}} action, local_realtime_tracker {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#results}}
                    <tr>
                        <td>{{categoryname}}</td>
                        <td>{{coursename}}<br><small><a href="{{courseurl}}" target="_blank">{{shortname}}</a></small></td>
                        <td>{{teachername}}</td>
                        <td class="text-center {{#url_iszero}}text-danger font-weight-bold{{/url_iszero}}">{{url_count}}</td>
                        <td class="text-center {{#label_iszero}}text-danger font-weight-bold{{/label_iszero}}">{{label_count}}</td>
                        <td class="text-center {{#assign_iszero}}text-danger font-weight-bold{{/assign_iszero}}">{{assign_count}}</td>
                        <td class="text-center {{#forum_iszero}}text-danger font-weight-bold{{/forum_iszero}}">{{forum_count}}</td>
                        <td class="text-center {{#file_iszero}}text-danger font-weight-bold{{/file_iszero}}">{{file_count}}</td>
                        <td class="text-center {{#teams_iszero}}text-danger font-weight-bold{{/teams_iszero}}">{{teams_count}}</td>
                        <td class="text-center {{#folder_iszero}}text-danger font-weight-bold{{/folder_iszero}}">{{folder_count}}</td>
                        <td class="text-center text-success {{#shared_iszero}}text-danger font-weight-bold{{/shared_iszero}}"><strong>{{shared_count}}</strong></td>
                        <td class="text-center {{#student_iszero}}text-danger font-weight-bold{{/student_iszero}}">{{student_count}}</td>
                        <td class="text-center text-info"><strong>{{connectiontime}}</strong></td>
                        <td class="text-center text-primary"><strong>{{creationtime}}</strong></td>
                        <td class="text-center">
                            <a href="{{detailurl}}" class="btn btn-sm btn-info text-white" target="_blank" title="{{#str}} viewdetail, local_realtime_tracker {{/str}}"><i class="fa fa-eye"></i></a>
                        </td>
                    </tr>
                    {{/results}}
                    {{^results}}
                    <tr>
                        <td colspan="15" class="text-center">{{#str}} nodata, local_realtime_tracker {{/str}}</td>
                    </tr>
                    {{/results}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-4 text-center text-muted">
    <small>{{#str}} footercredit, local_realtime_tracker {{/str}}</small>
</div>
