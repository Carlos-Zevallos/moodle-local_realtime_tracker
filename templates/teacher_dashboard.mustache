{{!
    @template local_realtime_tracker/teacher_dashboard

    Institutional teacher performance dashboard.

    Example context (json):
    {
        "topcategories": [{"id": 1, "name": "Faculty", "selected": false}],
        "total_creation_hours": 12.5,
        "total_ai_hours": 3.2,
        "chart1": "<div></div>",
        "chart2": "<div></div>"
    }
}}
<div class="mauri-teacher-dashboard p-4 bg-white shadow-sm border rounded">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h3 class="text-primary"><i class="fa fa-line-chart"></i> {{#str}} institutionaldashboard, local_realtime_tracker {{/str}}</h3>
        <button class="btn btn-outline-secondary" data-action="print-report">
            <i class="fa fa-download"></i> {{#str}} downloadpdf, local_realtime_tracker {{/str}}
        </button>
    </div>

    <div class="card mb-4 bg-light">
        <div class="card-body">
            <form method="get" action="reports_teachers.php" class="form-inline">
                <label class="mr-2 me-2" for="categoryid"><strong>{{#str}} faculty, local_realtime_tracker {{/str}}:</strong></label>
                <select id="categoryid" name="categoryid" class="form-control mr-3 me-3 custom-select">
                    <option value="0">{{#str}} allfaculties, local_realtime_tracker {{/str}}</option>
                    {{#topcategories}}
                        <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                    {{/topcategories}}
                </select>

                <label class="mr-2 me-2" for="subcategoryid"><strong>{{#str}} subcategory, local_realtime_tracker {{/str}}:</strong></label>
                <select id="subcategoryid" name="subcategoryid" class="form-control mr-3 me-3 custom-select">
                    <option value="0">{{#str}} all, local_realtime_tracker {{/str}}</option>
                </select>
                <button type="submit" class="btn btn-primary">{{#str}} filter, local_realtime_tracker {{/str}}</button>
            </form>
        </div>
    </div>

    <div class="row mb-4 text-center">
        <div class="col-md-6">
            <div class="card bg-primary text-white border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">{{#str}} totalcreationtime, local_realtime_tracker {{/str}}</h5>
                    <h2 class="display-4">{{total_creation_hours}} h</h2>
                    <small>{{#str}} totalcreationtime_desc, local_realtime_tracker {{/str}}</small>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card bg-info text-white border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title">{{#str}} totalaitime, local_realtime_tracker {{/str}}</h5>
                    <h2 class="display-4">{{total_ai_hours}} h</h2>
                    <small>{{#str}} totalaitime_desc, local_realtime_tracker {{/str}}</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    {{{chart1}}}
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    {{{chart2}}}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 text-center text-muted">
    <small>{{#str}} footercredit, local_realtime_tracker {{/str}}</small>
</div>
