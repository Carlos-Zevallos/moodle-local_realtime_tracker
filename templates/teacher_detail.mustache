<div class="mauri-student-detail p-4 bg-white shadow-sm border rounded">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h3 class="text-primary"><i class="fa fa-line-chart"></i> Análisis de Tiempo del Docente</h3>
    </div>

    <div class="alert alert-info d-flex align-items-center">
        <div class="mr-3 me-3" style="font-size: 2rem;"><i class="fa fa-user-circle"></i></div>
        <div>
            <strong>Docente:</strong> {{teachername}}<br>
            <small>{{teacheremail}}</small>
        </div>
    </div>

    <div class="row mb-4 text-center">
        <div class="col-md-4">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6 class="text-muted">Primer Acceso</h6>
                    <strong>{{firstaccess}}</strong>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6 class="text-muted">Último Acceso</h6>
                    <strong>{{lastaccess}}</strong>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-primary text-white border-0">
                <div class="card-body">
                    <h6 class="text-white-50">Tiempo Total en LMS</h6>
                    <strong>{{total_lms_time}}</strong>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Tiempo de Conexión y Creación por Recurso</h4>
    <div class="table-responsive">
        <table class="table table-bordered table-sm table-hover">
            <thead class="bg-dark text-white">
                <tr>
                    <th style="color: white;">{{#str}} activity, local_realtime_tracker {{/str}}</th>
                    <th style="color: white;">{{#str}} type, local_realtime_tracker {{/str}}</th>
                    <th style="color: white;">Accesos</th>
                    <th style="color: white;">Tiempo Navegando</th>
                    <th style="color: white;">Tiempo Creando/Editando</th>
                    <th style="color: white;">Tiempo Usando IA</th>
                </tr>
            </thead>
            <tbody>
                {{#activities}}
                <tr>
                    <td>{{name}}</td>
                    <td>{{type}}</td>
                    <td class="text-center">{{entries}}</td>
                    <td class="text-center"><strong>{{connection_time}}</strong></td>
                    <td class="text-center text-primary"><strong>{{creation_time}}</strong></td>
                    <td class="text-center text-info"><strong>{{{ai_time}}}</strong></td>
                </tr>
                {{/activities}}
                {{^activities}}
                <tr><td colspan="6" class="text-center">No hay registros de actividades para este docente.</td></tr>
                {{/activities}}
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 text-center text-muted">
    <small>desarrollado por Ing. Carlos Zevallos | PLUGIN MAURI|</small>
</div>

