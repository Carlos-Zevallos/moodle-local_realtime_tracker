{{!
    @template local_realtime_tracker/teacher_detail

    Teacher activity detail report.

    Example context (json):
    {
        "teachername": "Teacher Name",
        "teacheremail": "teacher@example.com",
        "total_lms_time": "2h 15m",
        "activities": [{"name": "Forum", "type": "forum", "entries": 4, "connection_time": "1h 0m", "creation_time": "0h 20m", "ai_time": "0h 5m"}]
    }
}}
<div class="mauri-student-detail p-4 bg-white shadow-sm border rounded">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h3 class="text-primary"><i class="fa fa-line-chart"></i> {{#str}} teacheranalysis, local_realtime_tracker {{/str}}</h3>
    </div>

    <div class="alert alert-info d-flex align-items-center">
        <div class="mr-3 me-3" style="font-size: 2rem;"><i class="fa fa-user-circle"></i></div>
        <div>
            <strong>{{#str}} teacher, local_realtime_tracker {{/str}}:</strong> {{teachername}}<br>
            <small>{{teacheremail}}</small>
        </div>
    </div>

    <div class="row mb-4 text-center">
        <div class="col-md-4">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6 class="text-muted">{{#str}} firstaccess, local_realtime_tracker {{/str}}</h6>
                    <strong>{{firstaccess}}</strong>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <h6 class="text-muted">{{#str}} lastaccess, local_realtime_tracker {{/str}}</h6>
                    <strong>{{lastaccess}}</strong>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-primary text-white border-0">
                <div class="card-body">
                    <h6 class="text-white-50">{{#str}} totallmstime, local_realtime_tracker {{/str}}</h6>
                    <strong>{{total_lms_time}}</strong>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">{{#str}} connectionandcreation, local_realtime_tracker {{/str}}</h4>
    <div class="table-responsive">
        <table class="table table-bordered table-sm table-hover">
            <thead style="background-color: #0d6efd !important;">
                <tr>
                    <th style="color: #ffffff !important;">{{#str}} activity, local_realtime_tracker {{/str}}</th>
                    <th style="color: #ffffff !important;">{{#str}} type, local_realtime_tracker {{/str}}</th>
                    <th style="color: #ffffff !important;">{{#str}} accesses, local_realtime_tracker {{/str}}</th>
                    <th style="color: #ffffff !important;">{{#str}} timebrowsing, local_realtime_tracker {{/str}}</th>
                    <th style="color: #ffffff !important;">{{#str}} timecreating, local_realtime_tracker {{/str}}</th>
                    <th style="color: #ffffff !important;">{{#str}} timeai, local_realtime_tracker {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#activities}}
                <tr>
                    <td>{{name}}</td>
                    <td>{{type}}</td>
                    <td class="text-center">{{entries}}</td>
                    <td class="text-center"><strong>{{connection_time}}</strong></td>
                    <td class="text-center text-primary"><strong>{{creation_time}}</strong></td>
                    <td class="text-center text-info"><strong>{{ai_time}}</strong></td>
                </tr>
                {{/activities}}
                {{^activities}}
                <tr><td colspan="6" class="text-center">{{#str}} noactivityrecords_teacher, local_realtime_tracker {{/str}}</td></tr>
                {{/activities}}
            </tbody>
        </table>
    </div>
</div>

<div class="mt-4 text-center text-muted">
    <small>{{#str}} footercredit, local_realtime_tracker {{/str}}</small>
</div>
